# Postgres (docker compose maps host port 5442 to avoid clashing with a local install, or a Neon connection string)
DATABASE_URL="postgresql://leadlens:leadlens@localhost:5442/leadlens"

# Redis (docker compose default, or Upstash: rediss://default:<token>@<host>:6379)
REDIS_URL="redis://localhost:6380"

# LLM provider: mock | openai | anthropic. "mock" needs no key and is deterministic.
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Enrichment
ENRICHMENT_USER_AGENT="LeadLensBot/1.0 (+https://example.com/bot; contact: bot@example.com)"
ENRICHMENT_TTL_HOURS="168"
ENRICHMENT_DOMAIN_DELAY_MS="1500"
ENRICHMENT_TIMEOUT_MS="8000"
ENRICHMENT_CONCURRENCY="4"
# Set to "true" to skip real HTTP requests and synthesize results from the seed data (demo/offline/CI).
ENRICHMENT_OFFLINE="false"

# Sender identity used in outreach drafts (editable per draft in the UI)
OUTREACH_SENDER_NAME="Alex Morgan"
OUTREACH_SENDER_FIRM="Caprae Capital"

LOG_LEVEL="info"
